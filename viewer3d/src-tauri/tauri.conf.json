{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viewer 3D",
  "version": "0.0.1",
  "identifier": "me.ergofox.viewer3d",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Viewer 3D",
        "width": 800,
        "height": 600,
        "backgroundColor": "#EEF0F4"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "cli": {
      "description": "Open a 3D model; optionally save a screenshot next to it",
      "args": [
        {
          "name": "screenshot",
          "description": "Save a JPG screenshot next to the opened model",
          "takesValue": false,
          "required": false
        },
        {
          "name": "path",
          "description": "Path to the model to open (.glb, .gltf, .fbx)",
          "index": 1,
          "takesValue": true,
          "required": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
